APP_NAME=Lumens
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090
APP_TIMEZONE=America/El_Salvador

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=lumens_ecommerce
DB_USERNAME=lumens
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

ERP_BASE_URL=https://erp.example.com/api
ERP_API_KEY=
ERP_TIMEOUT=30
ERP_RETRY_ATTEMPTS=3
ERP_RETRY_DELAY=2
ERP_INBOUND_SOURCE=erp
ERP_MAX_ITEMS_PER_BATCH=1000
ERP_ENFORCE_IDEMPOTENCY=true
# Scheduler pull ERP (habilitar en servidor)
ERP_PULL_SCHEDULE_ENABLED=false
ERP_PULL_FULL_AT=03:00
ERP_PULL_INVENTORY_CRON=*/15 * * * *
ERP_PULL_PRICES_CRON=0 * * * *
LUMEN_PUBLIC_URL=http://localhost:8084
LUMEN_PRODUCT_IMAGE_PATH=public/images/product

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="ventas@lumens.local"
MAIL_FROM_NAME="${APP_NAME}"
QUOTE_NOTIFICATION_EMAILS=douglas.manzanares@lumens.com.sv

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
